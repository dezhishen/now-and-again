{
  "name": "now-and-again-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "cd e2e && npx playwright test --project=chromium",
    "test:e2e-headed": "cd e2e && npx playwright test --headed --project=chromium",
    "screenshots": "cd e2e && npm run screenshots",
    "check-i18n": "npx tsx scripts/check-i18n.ts"
  },
  "dependencies": {
    "js-yaml": "^5.2.0",
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-i18n": "9",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.5.2",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.15",
    "tailwindcss": "3",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.1.0"
  }
}
