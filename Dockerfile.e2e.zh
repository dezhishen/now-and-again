# E2E TOOLCHAIN IMAGE (CN mirrors, no project code)
#
# Display: Xorg with modesetting + DRI (needs --privileged for DRM master).
# Falls back to xvfb when GPU unavailable or Xorg fails.
# See scripts/e2e-display.sh for the runtime logic.
#
# Goal:
# - Build once, reuse everywhere.
# - Mount source code at runtime and run E2E in container.

FROM mcr.azure.cn/playwright:v1.61.1-noble

ARG GO_VERSION=1.25.0

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai

# Use mainland mirrors for apt where possible.
RUN sed -i 's|http://archive.ubuntu.com/ubuntu/|https://mirrors.aliyun.com/ubuntu/|g' /etc/apt/sources.list.d/ubuntu.sources \
  && sed -i 's|http://security.ubuntu.com/ubuntu/|https://mirrors.aliyun.com/ubuntu/|g' /etc/apt/sources.list.d/ubuntu.sources

# Install Go toolchain, common utilities, and display servers.
# xorg → internal X server (GPU) | xvfb → fallback
# gosu → user switching for file permission compat
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates curl git make xz-utils gosu \
    xserver-xorg-core xserver-xorg-video-all x11-xserver-utils xauth xvfb mesa-utils \
  && rm -rf /var/lib/apt/lists/*

RUN set -e; \
  for u in \
    "https://mirrors.aliyun.com/golang/go${GO_VERSION}.linux-amd64.tar.gz" \
    "https://golang.google.cn/dl/go${GO_VERSION}.linux-amd64.tar.gz" \
    "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz"; do \
    echo "Trying ${u}"; \
    if curl -fL --connect-timeout 10 --retry 3 --retry-delay 2 "${u}" -o /tmp/go.tgz; then \
      rm -rf /usr/local/go; \
      tar -C /usr/local -xzf /tmp/go.tgz; \
      rm -f /tmp/go.tgz; \
      exit 0; \
    fi; \
  done; \
  echo "Failed to download Go ${GO_VERSION}"; \
  exit 1

ENV PATH="/usr/local/go/bin:${PATH}"
ENV GOPROXY="https://goproxy.cn,direct"

# Deterministic frontend toolchain — pin version + CN mirror for corepack itself.
ENV COREPACK_NPM_REGISTRY=https://registry.npmmirror.com
RUN corepack enable && corepack prepare pnpm@10.15.0 --activate \
  && pnpm config set registry https://registry.npmmirror.com

# Pre-create X11 socket directory
RUN mkdir -p /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix

# Display & entrypoint scripts.
COPY scripts/e2e-display.sh /usr/local/bin/e2e-display
COPY scripts/e2e-entrypoint.sh /usr/local/bin/e2e-entrypoint

ENTRYPOINT ["/usr/local/bin/e2e-entrypoint"]
CMD ["bash"]