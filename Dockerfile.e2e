# E2E TOOLCHAIN IMAGE (no project code inside image)
#
# Display: Xorg with modesetting + DRI (needs --privileged for DRM master).
# Falls back to xvfb when GPU unavailable or Xorg fails.
# See scripts/e2e-display.sh for the runtime logic.
#
# Goal:
# - Build once, reuse everywhere.
# - Mount source code at runtime and run E2E in container.

FROM mcr.microsoft.com/playwright:v1.61.1-noble

ARG GO_VERSION=1.25.0

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai

# Install Go toolchain, common utilities, and display servers.
# xorg → internal X server (GPU) | xvfb → fallback
# gosu → user switching for file permission compat
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates curl git make xz-utils gosu \
    xserver-xorg-core xserver-xorg-video-all x11-xserver-utils xauth xvfb mesa-utils \
  && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" -o /tmp/go.tgz \
  && rm -rf /usr/local/go \
  && tar -C /usr/local -xzf /tmp/go.tgz \
  && rm -f /tmp/go.tgz

ENV PATH="/usr/local/go/bin:${PATH}"

# Deterministic frontend toolchain — pin version to avoid re-downloads.
RUN corepack enable && corepack prepare pnpm@10.15.0 --activate

# Pre-create X11 socket directory
RUN mkdir -p /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix

# Display & entrypoint scripts.
COPY scripts/e2e-display.sh /usr/local/bin/e2e-display
COPY scripts/e2e-entrypoint.sh /usr/local/bin/e2e-entrypoint

ENTRYPOINT ["/usr/local/bin/e2e-entrypoint"]
CMD ["bash"]